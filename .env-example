# Secrets and identifiers used while building this project.
# Copy this to env.private (NOT .env -- see README.md) and fill in your own values. env.private is
# gitignored and should never be committed.

# --- Confluent Cloud ---
CONFLUENT_ENVIRONMENT_ID=<your-environment-id>
CONFLUENT_ENVIRONMENT_NAME=<your-environment-name>
CONFLUENT_ORG_ID=<your-org-id>
CONFLUENT_ORG_NAME=<your-org-name>

# --- Azure ---
AZURE_SUBSCRIPTION_ID=<your-azure-subscription-id>
AZURE_SUBSCRIPTION_NAME=<your-azure-subscription-name>
AZURE_RESOURCE_GROUP=<your-resource-group>
AZURE_TENANT_ID=<your-azure-tenant-id>

# --- Confluent Cloud networks (classic Private Link model, required for Dedicated clusters) ---
CONFLUENT_PRIMARY_NETWORK_ID=<primary-network-id>
CONFLUENT_PRIMARY_NETWORK_NAME=<primary-network-name>
CONFLUENT_PRIMARY_DNS_DOMAIN=<primary-dns-domain>.westeurope.azure.confluent.cloud
CONFLUENT_PRIMARY_PL_ACCESS_ID=<primary-private-link-access-id>

CONFLUENT_DR_NETWORK_ID=<dr-network-id>
CONFLUENT_DR_NETWORK_NAME=<dr-network-name>
CONFLUENT_DR_DNS_DOMAIN=<dr-dns-domain>.northeurope.azure.confluent.cloud
CONFLUENT_DR_PL_ACCESS_ID=<dr-private-link-access-id>

# --- Confluent Cloud Kafka clusters (Dedicated, 1 CKU, single-zone) ---
CONFLUENT_PRIMARY_CLUSTER_ID=<primary-cluster-id>
CONFLUENT_PRIMARY_CLUSTER_NAME=<primary-cluster-name>
CONFLUENT_PRIMARY_CLUSTER_BOOTSTRAP=<primary-cluster-id>.<primary-dns-domain>.westeurope.azure.confluent.cloud:9092
CONFLUENT_PRIMARY_CLUSTER_REST=https://<primary-cluster-id>.<primary-dns-domain>.westeurope.azure.confluent.cloud:443

CONFLUENT_DR_CLUSTER_ID=<dr-cluster-id>
CONFLUENT_DR_CLUSTER_NAME=<dr-cluster-name>
CONFLUENT_DR_CLUSTER_BOOTSTRAP=<dr-cluster-id>.<dr-dns-domain>.northeurope.azure.confluent.cloud:9092
CONFLUENT_DR_CLUSTER_REST=https://<dr-cluster-id>.<dr-dns-domain>.northeurope.azure.confluent.cloud:443

# --- Azure Private DNS zones / zonal private endpoints ---
AZURE_PRIMARY_DNS_ZONE=<primary-dns-domain>.westeurope.azure.confluent.cloud
AZURE_PRIMARY_PE_AZ1_IP=<primary-pe-az1-ip>
AZURE_PRIMARY_PE_AZ2_IP=<primary-pe-az2-ip>
AZURE_PRIMARY_PE_AZ3_IP=<primary-pe-az3-ip>
AZURE_DR_DNS_ZONE=<dr-dns-domain>.northeurope.azure.confluent.cloud
AZURE_DR_PE_AZ1_IP=<dr-pe-az1-ip>
AZURE_DR_PE_AZ2_IP=<dr-pe-az2-ip>
AZURE_DR_PE_AZ3_IP=<dr-pe-az3-ip>

# --- Azure VM ---
AZURE_VM_NAME=<your-vm-name>
AZURE_VM_REGION=<your-vm-region>
AZURE_VM_PUBLIC_IP=<your-vm-public-ip>
AZURE_VM_PRIVATE_IP=<your-vm-private-ip>
AZURE_VM_ADMIN_USER=<your-vm-admin-user>
AZURE_VM_SSH_PRIVATE_KEY_PATH=./keys/<your-vm-ssh-key-name>
# If SSH is restricted in your environment, use `az vm run-command invoke -g $RESOURCE_GROUP -n
# $VM_NAME --command-id RunShellScript --scripts "..."` instead -- see COMMANDS.md.

# --- Confluent Cloud API key (primary cluster, used by datagen connector + VM client testing) ---
CONFLUENT_PRIMARY_API_KEY=<primary-api-key>
CONFLUENT_PRIMARY_API_SECRET=<primary-api-secret>

# --- Datagen connector ---
CONFLUENT_DATAGEN_CONNECTOR_ID=<datagen-connector-id>
CONFLUENT_DATAGEN_CONNECTOR_NAME=<datagen-connector-name>
CONFLUENT_DATAGEN_TOPIC=<datagen-topic>

# --- DR Automatic Failover tutorial ---
CONFLUENT_DR_LINK_SA_ID=<dr-link-service-account-id>
CONFLUENT_DR_LINK_SA_NAME=<dr-link-service-account-name>
CONFLUENT_DR_LINK_GLOBAL_API_KEY=<dr-link-global-api-key>
CONFLUENT_DR_LINK_GLOBAL_API_SECRET=<dr-link-global-api-secret>
CONFLUENT_DR_LINK_ROLE_BINDING_PRIMARY=<dr-link-role-binding-id-primary>
CONFLUENT_DR_LINK_ROLE_BINDING_DR=<dr-link-role-binding-id-dr>
CONFLUENT_DR_LINK_NAME=dr-link

CONFLUENT_SWITCHOVER_PAIR_ID=<switchover-pair-id>
CONFLUENT_SWITCHOVER_PAIR_NAME=<switchover-pair-name>
# status.phase should settle at READY_TO_FAILOVER

CONFLUENT_SWITCHOVER_ENDPOINT_ID=<switchover-endpoint-id>
CONFLUENT_SWITCHOVER_ENDPOINT_NAME=<switchover-endpoint-name>
# status.phase should settle at READY

CONFLUENT_GLOBAL_BOOTSTRAP_URL=glkc-<pair-id>-<endpoint-id>.global.glb.confluent.cloud:9092

# Test client used to verify the global bootstrap URL end-to-end (needs a GLOBAL api key, not
# cluster-scoped, per the tutorial's auth requirements). Needs DeveloperWrite/DeveloperRead on
# Topic:<datagen-topic> and DeveloperRead on Group:<test-consumer-group>, on BOTH clusters.
CONFLUENT_DR_TEST_CLIENT_SA_ID=<dr-test-client-service-account-id>
CONFLUENT_DR_TEST_CLIENT_SA_NAME=<dr-test-client-service-account-name>
CONFLUENT_DR_TEST_CLIENT_GLOBAL_API_KEY=<dr-test-client-global-api-key>
CONFLUENT_DR_TEST_CLIENT_GLOBAL_API_SECRET=<dr-test-client-global-api-secret>
CONFLUENT_DR_TEST_CLIENT_GROUP_ID=dr-test-consumer

# --- Demo app (producer + consumer + dashboard), demo-app/ directory, deployed to the VM ---
# Dedicated service account for the demo backend, needed because calling the Switchover
# Management REST API requires org/environment-admin scope, which the other service accounts
# above don't have.
CONFLUENT_DEMO_BACKEND_SA_ID=<demo-backend-service-account-id>
CONFLUENT_DEMO_BACKEND_SA_NAME=<demo-backend-service-account-name>
CONFLUENT_DEMO_BACKEND_ROLE_BINDING=<demo-backend-role-binding-id>
# EnvironmentAdmin on <your-environment-id>
CONFLUENT_DEMO_BACKEND_CLOUD_API_KEY=<demo-backend-cloud-api-key>
CONFLUENT_DEMO_BACKEND_CLOUD_API_SECRET=<demo-backend-cloud-api-secret>

# Demo topic + consumer group (separate from the datagen topic above)
CONFLUENT_DEMO_TOPIC=<demo-topic>
CONFLUENT_DEMO_CONSUMER_GROUP=<demo-consumer-group>

# The demo app's Kafka data-plane credential can reuse the DR test client's global key above --
# it also needs DeveloperWrite/DeveloperRead on Topic:<demo-topic> and DeveloperRead on
# Group:<demo-consumer-group>, on both clusters.

# The actual secrets deployed to the VM live at /opt/<app-name>/demo.env (root-owned process,
# chmod 600 -- NOT this file). See README.md "Demo app" section for the full list of env vars it
# needs and how to redeploy. App source lives in ./demo-app/ (no secrets committed there --
# config.js reads everything from the environment).
# Dashboard: http://<your-vm-public-ip>/ (NSG must allow inbound 80/443)

# --- Confluent Cloud Metrics API (demo-app/metrics.js) ---
# Reuses CONFLUENT_DEMO_BACKEND_CLOUD_API_KEY/SECRET above -- the same Cloud API key works for
# both the Switchover Management API (api.confluent.cloud) and the Metrics API
# (api.telemetry.confluent.cloud). No separate credential is needed.
# Metrics used: io.confluent.kafka.server/request_bytes (per cluster, by request type) and
# io.confluent.kafka.server/cluster_link_mirror_topic_offset_lag (queried against whichever side
# is currently standby, filtered to link_name=dr-link, topic=<demo-topic>).
